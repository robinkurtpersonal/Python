print("Name: BSP_ifelse_Menu_Selector")
print("Description: Simple demo for if else and how only exactly one will execute")

#age input | type: integer | purpose: to capture user age
age = int(input("What is your age? "))

#if condition 1 = exec if age > 12
if age > 12:
    print("Menu.")
    
#exec all instances where age is NOT equal to 12 / Cond 1 is wrong
else:
    print("Kid's Menu.")
    
#always executes (no ident, part of the main program)
print("Take Order.")
print("Thank you!")
